# Copy to .env (never commit .env). Read by the backend container via compose.yaml.

# Supabase Dashboard -> Project Settings -> API (or "Connect").
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key.
# NEVER the secret / service_role key: the backend relies on row-level security.
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# false only for local http://localhost. Must be true when hosted over HTTPS.
COOKIE_SECURE=false

# Groq API key for "! instruction !" LaTeX generation (console.groq.com -> API Keys). Optional.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
